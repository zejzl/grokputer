{
  "dashboard": {
    "id": null,
    "title": "Grokputer Performance Monitoring",
    "tags": ["grokputer", "performance", "monitoring"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "System Resources",
        "type": "row",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "CPU Usage",
        "type": "graph",
        "targets": [
          {
            "expr": "cpu_usage_percent",
            "legendFormat": "CPU Usage %"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 1}
      },
      {
        "id": 3,
        "title": "Memory Usage",
        "type": "graph",
        "targets": [
          {
            "expr": "memory_usage_percent",
            "legendFormat": "Memory Usage %"
          },
          {
            "expr": "memory_used_bytes / memory_total_bytes * 100",
            "legendFormat": "Memory Usage % (calculated)"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 1}
      },
      {
        "id": 4,
        "title": "Disk Usage",
        "type": "graph",
        "targets": [
          {
            "expr": "disk_usage_percent",
            "legendFormat": "Disk Usage %"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 9}
      },
      {
        "id": 5,
        "title": "API Performance",
        "type": "row",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 17}
      },
      {
        "id": 6,
        "title": "API Calls per Second",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(api_calls_total[5m])",
            "legendFormat": "API Calls/sec"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 18}
      },
      {
        "id": 7,
        "title": "API Response Time",
        "type": "graph",
        "targets": [
          {
            "expr": "api_response_time_avg_seconds",
            "legendFormat": "Avg Response Time (s)"
          },
          {
            "expr": "histogram_quantile(0.95, rate(api_request_duration_seconds_bucket[5m]))",
            "legendFormat": "95th Percentile"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 18}
      },
      {
        "id": 8,
        "title": "Agent API Calls",
        "type": "barchart",
        "targets": [
          {
            "expr": "sum by (agent) (agent_api_calls_total)",
            "legendFormat": "{{agent}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 26}
      },
      {
        "id": 9,
        "title": "MAF Orchestration",
        "type": "row",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 34}
      },
      {
        "id": 10,
        "title": "MAF Success Rate",
        "type": "gauge",
        "targets": [
          {
            "expr": "maf_success_rate * 100",
            "legendFormat": "Success Rate %"
          }
        ],
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 35}
      },
      {
        "id": 11,
        "title": "MAF Orchestrations per Minute",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(maf_orchestrations_total[5m]) * 60",
            "legendFormat": "Orchestrations/min"
          }
        ],
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 35}
      },
      {
        "id": 12,
        "title": "MAF Execution Time",
        "type": "graph",
        "targets": [
          {
            "expr": "maf_execution_time_avg_seconds",
            "legendFormat": "Avg Execution Time (s)"
          }
        ],
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 35}
      },
      {
        "id": 13,
        "title": "MAF Provider Distribution",
        "type": "piechart",
        "targets": [
          {
            "expr": "maf_provider_usage_total",
            "legendFormat": "{{providers}} providers"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 43}
      },
      {
        "id": 14,
        "title": "Alerts",
        "type": "alertlist",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 43}
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {},
    "templating": {
      "list": []
    },
    "annotations": {
      "list": []
    },
    "refresh": "30s",
    "schemaVersion": 27,
    "version": 0,
    "links": []
  }
}