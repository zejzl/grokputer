# Model Configuration
GROK_MODEL=grok-4-fast-reasoning
# xAI API Base URL (OpenAI-compatible endpoint)
XAI_BASE_URL=https://api.x.ai/v1

# Anthropic Claude API Configuration (REQUIRED for collaboration mode only)
# Get your API key from: https://console.anthropic.com/
# Used when running: python main.py -mb --task "your task"
ANTHROPIC_API_KEY=your_anthropic_api_key_here

#GEMINI_API_KEY=your_gemini_api_key_here

# Safety Settings
REQUIRE_CONFIRMATION=false

# Vault Configuration
VAULT_PATH=./vault

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/grokputer.log

# Screenshot Settings
SCREENSHOT_QUALITY=75
MAX_SCREENSHOT_SIZE=1920x1080

# Redis Configuration (for Pantheon mode learning persistence)
REDIS_URL=redis://localhost:6379

# Collaboration Mode Settings (optional)
# Print unified plan to console after generation
PRINT_PLAN=false
# Convergence threshold for consensus detection (0-1, default: 0.6)
CONVERGENCE_THRESHOLD=0.6
# Maximum collaboration rounds (default: 5)
MAX_COLLABORATION_ROUNDS=5

# ===== ALERT NOTIFICATIONS =====
# Email and Slack alerts for critical events (evolutions, proposals, security issues)

# Email Alerts (SMTP)
ENABLE_EMAIL_ALERTS=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
EMAIL_FROM=your_email@gmail.com
# Comma-separated list of recipients
EMAIL_TO=alert@example.com,team@example.com

# Slack Alerts (Webhook)
ENABLE_SLACK_ALERTS=false
# Get your webhook URL from: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Alert Level (minimum severity to send)
# Options: INFO, WARNING, CRITICAL
# Default: WARNING (only send warnings and critical alerts)
ALERT_MIN_LEVEL=WARNING
