# .env Example - Copy to .env and fill in keys

# API Keys (src/config.py refuses to import without XAI_API_KEY, even if you only use another provider)
XAI_API_KEY=your_xai_key_here  # Grok (priority)
ANTHROPIC_API_KEY=sk-ant-your_claude_key_here  # Fallback
GEMINI_API_KEY=your_gemini_key_here  # Fallback
OPENAI_API_KEY=your_openai_key_here  # Used by MAF mode (--providers openai)

# Provider Config
PRIORITY_PROVIDER=grok  # grok, claude, claude-cli, gemini
FALLBACK_PROVIDERS=claude,gemini  # Comma-separated (may include claude-cli)

# Models
GROK_MODEL=grok-beta
GROK_VISION_MODEL=  # Optional: model used when a screenshot is attached (defaults to GROK_MODEL)
CLAUDE_MODEL=claude-haiku-5-5
GEMINI_MODEL=gemini-pro
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# Claude through the `claude` CLI (uses your Claude subscription, no API credits; text only)
# Set PRIORITY_PROVIDER=claude-cli to use it. Needs `claude` on PATH and logged in.
CLAUDE_CLI_MODEL=haiku  # haiku, sonnet, opus

# MAF mode (--providers / menu option 9) calls real models; set to 1 for canned mock responses
MAF_USE_MOCK=0

# Other (from original .env)
XAI_BASE_URL=https://api.x.ai/v1
REQUIRE_CONFIRMATION=false
VAULT_PATH=./vault
LOG_LEVEL=INFO
LOG_FILE=./logs/grokputer.log
SCREENSHOT_QUALITY=85
MAX_SCREENSHOT_SIZE=1920x1080

# S3 Backup Config
S3_BUCKET_NAME=your_s3_bucket_name
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-east-1